// FluxionAI — Prisma Schema
// Plataforma inteligente de produtividade

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum CardPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum CardStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  ARCHIVED
}

enum DocumentType {
  RESUME
  REPORT
  MEETING_NOTES
  CUSTOM
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum IntegrationProvider {
  GITHUB
  GITLAB
  BITBUCKET
  GOOGLE
}

enum NotificationType {
  MENTION
  ASSIGNMENT
  DUE_DATE
  SYSTEM
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  USAGE
}

// ─── USER & AUTH ────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String   @unique
  passwordHash String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  emailRequestsCount Int @default(0)
  lastEmailRequestAt DateTime?
  termsAcceptedAt    DateTime?
  termsVersion       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  workspaceMemberships WorkspaceMember[]
  assignedCards        Card[]             @relation("CardAssignee")
  createdCards         Card[]             @relation("CardCreator")
  comments             Comment[]
  documents            Document[]
  aiChats              AIChat[]
  aiConfig             UserAiConfig?
  integrations         Integration[]
  activityLogs         ActivityLog[]
  notifications        Notification[]
  productivityMetrics  ProductivityMetric[]
  refreshTokens        RefreshToken[]
  verificationToken    VerificationToken?
  passwordResetToken   PasswordResetToken?
  savedLeads           SavedLead[]
  systemLogs           SystemLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}



// ─── WORKSPACE ──────────────────────────────────────────

model Workspace {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?
  slug        String   @unique
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members      WorkspaceMember[]
  projects     Project[]
  tags         Tag[]
  activityLogs ActivityLog[]
  agents       Agent[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

// ─── PROJECT & BOARDS ───────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  description String?
  color       String?  @db.VarChar(7) // hex color
  isArchived  Boolean  @default(false)
  localPath   String?  @db.VarChar(255) // local path to repo
  githubRepo  String?  @db.VarChar(200) // format: owner/repo
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boards    Board[]

  @@map("projects")
}

model Board {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns Column[]

  @@map("boards")
}

model Column {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  position  Int      @default(0)
  color     String?  @db.VarChar(7)
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@map("columns")
}

// ─── CARDS (TAREFAS) ────────────────────────────────────

model Card {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(200)
  description String?
  position    Int          @default(0)
  priority          CardPriority @default(NONE)
  status            CardStatus   @default(TODO)
  dueDate           DateTime?
  branchName        String?      @db.VarChar(100) // e.g. feature/add-login
  githubIssueNumber Int?
  columnId          String
  assigneeId  String?
  creatorId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?  @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User   @relation("CardCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  tags     CardTag[]
  comments Comment[]

  @@map("cards")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(30)
  color       String   @db.VarChar(7) // hex color
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     CardTag[]

  @@unique([name, workspaceId])
  @@map("tags")
}

model CardTag {
  cardId String
  tagId  String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@map("card_tags")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  cardId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}


// ─── DOCUMENTS ──────────────────────────────────────────

model Document {
  id        String       @id @default(uuid())
  title     String       @db.VarChar(200)
  content   String // markdown/html content
  type      DocumentType @default(CUSTOM)
  authorId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ─── AI CHAT ────────────────────────────────────────────

model AIChat {
  id        String   @id @default(uuid())
  title     String?  @db.VarChar(200)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@map("ai_chats")
}

model AIMessage {
  id        String        @id @default(uuid())
  role      AIMessageRole
  content   String
  chatId    String
  createdAt DateTime      @default(now())

  chat AIChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

// ─── USER AI CONFIG ─────────────────────────────────────

model UserAiConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  provider  String   @db.VarChar(30)  // "gemini" | "openai" | "anthropic"
  model     String   @db.VarChar(100) // e.g. "gpt-4o", "claude-3-5-sonnet-20241022"
  apiKey    String   // stored as-is (Supabase encrypts at rest)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ai_configs")
}

// ─── INTEGRATIONS ───────────────────────────────────────

model Integration {
  id           String              @id @default(uuid())
  provider     IntegrationProvider
  accessToken  String
  refreshToken String?
  externalId   String? // GitHub user id, etc.
  metadata     Json? // provider-specific data
  userId       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, userId])
  @@map("integrations")
}

// ─── ACTIVITY LOG ───────────────────────────────────────

model ActivityLog {
  id          String   @id @default(uuid())
  action      String   @db.VarChar(100) // "card.created", "card.moved", etc.
  entityType  String   @db.VarChar(50) // "card", "board", "project"
  entityId    String
  metadata    Json? // extra context
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     LogLevel
  module    String   @db.VarChar(50) // "AI", "GMAIL", "AUTOMATION", etc.
  message   String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("system_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String?
  isRead    Boolean          @default(false)
  linkUrl   String? // deep link to resource
  userId    String
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── PRODUCTIVITY METRICS ───────────────────────────────

model ProductivityMetric {
  id             String   @id @default(uuid())
  date           DateTime @db.Date
  cardsCreated   Int      @default(0)
  cardsCompleted Int      @default(0)
  commentsAdded  Int      @default(0)
  focusMinutes   Int      @default(0)
  userId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("productivity_metrics")
}

// ─── SAVED LEADS ────────────────────────────────────────

model SavedLead {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(200)
  location        String?
  niche           String?
  probability     Int?
  suggestedBudget String?
  whatsappPrompt  String?  @db.Text
  userId          String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_leads")
}

// ─── GATEWAY API (AGENTS & ACTIONS) ─────────────────────

enum AgentPlan {
  BASIC
  PRO
}

enum AgentEnvironment {
  DEVELOPMENT
  PRODUCTION
}

enum AgentStatus {
  ACTIVE
  REVOKED
}

model Agent {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  description  String?   @db.Text
  systemPrompt String?   @db.Text
  planType     AgentPlan @default(BASIC)
  environment  AgentEnvironment @default(DEVELOPMENT)
  status       AgentStatus @default(ACTIVE)
  apiKeyHash   String    @unique @default("") @db.VarChar(255)
  apiKeyPrefix String?   @db.VarChar(20)
  workspaceId  String
  permissions  Json?     @db.JsonB
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions      Action[]
  customers    Customer[]
  conversations Conversation[]
  apiKeyLogs   ApiKeyLog[]

  @@map("agents")
}

model ApiKeyLog {
  id               String   @id @default(uuid())
  agentId          String
  workspaceId      String
  permission       String?  @db.VarChar(100)
  endpoint         String   @db.VarChar(255)
  method           String   @db.VarChar(10)
  result           String   @db.VarChar(20) // ALLOWED, DENIED
  ip               String?  @db.VarChar(50)
  userAgent        String?  @db.Text
  createdAt        DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("api_key_logs")
}

model Action {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  description    String   @db.Text
  method         String   @db.VarChar(10)
  endpointUrl    String   @db.VarChar(255)
  headers        Json?
  schemaJson     Json?
  requiresApproval Boolean @default(false)
  agentId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  logs  ActionLog[]

  @@map("actions")
}

model Customer {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(150)
  phone      String?  @db.VarChar(30)
  email      String?  @db.VarChar(100)
  externalId String?  @db.VarChar(100)
  agentId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([agentId, externalId])
  @@map("customers")
}

model Conversation {
  id         String   @id @default(uuid())
  channel    String   @db.VarChar(30)
  agentId    String
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  role           AIMessageRole
  content        String   @db.Text
  conversationId String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ActionLog {
  id          String   @id @default(uuid())
  actionName  String   @db.VarChar(100)
  status      Int
  payload     Json?
  response    Json?
  tokensUsed  Int      @default(0)
  actionId    String
  createdAt   DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("action_logs")
}
