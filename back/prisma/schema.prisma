// OrbSync — Prisma Schema
// Plataforma inteligente de produtividade

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum CardPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum CardStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  ARCHIVED
}

enum AutomationTrigger {
  CARD_MOVED
  CARD_CREATED
  DUE_DATE_REACHED
  STATUS_CHANGED
  TERMINAL_COMMAND
}

enum DocumentType {
  RESUME
  REPORT
  MEETING_NOTES
  CUSTOM
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum IntegrationProvider {
  GITHUB
  GITLAB
  BITBUCKET
  GOOGLE
}

enum NotificationType {
  MENTION
  ASSIGNMENT
  DUE_DATE
  SYSTEM
}

// ─── USER & AUTH ────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  workspaceMemberships WorkspaceMember[]
  assignedCards        Card[]             @relation("CardAssignee")
  createdCards         Card[]             @relation("CardCreator")
  comments             Comment[]
  documents            Document[]
  aiChats              AIChat[]
  integrations         Integration[]
  activityLogs         ActivityLog[]
  notifications        Notification[]
  productivityMetrics  ProductivityMetric[]
  refreshTokens        RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── WORKSPACE ──────────────────────────────────────────

model Workspace {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?
  slug        String   @unique
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members      WorkspaceMember[]
  projects     Project[]
  tags         Tag[]
  automations  Automation[]
  activityLogs ActivityLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

// ─── PROJECT & BOARDS ───────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  description String?
  color       String?  @db.VarChar(7) // hex color
  isArchived  Boolean  @default(false)
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boards    Board[]

  @@map("projects")
}

model Board {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns Column[]

  @@map("boards")
}

model Column {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  position  Int      @default(0)
  color     String?  @db.VarChar(7)
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@map("columns")
}

// ─── CARDS (TAREFAS) ────────────────────────────────────

model Card {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(200)
  description String?
  position    Int          @default(0)
  priority    CardPriority @default(NONE)
  status      CardStatus   @default(TODO)
  dueDate     DateTime?
  columnId    String
  assigneeId  String?
  creatorId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?  @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User   @relation("CardCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  tags     CardTag[]
  comments Comment[]

  @@map("cards")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(30)
  color       String   @db.VarChar(7) // hex color
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     CardTag[]

  @@unique([name, workspaceId])
  @@map("tags")
}

model CardTag {
  cardId String
  tagId  String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@map("card_tags")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  cardId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ─── AUTOMATIONS ────────────────────────────────────────

model Automation {
  id          String             @id @default(uuid())
  name        String             @db.VarChar(100)
  description String?
  trigger     AutomationTrigger
  actionRules Json // { action: "move_card", targetColumnId: "..." }
  isActive    Boolean            @default(true)
  workspaceId String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("automations")
}

// ─── DOCUMENTS ──────────────────────────────────────────

model Document {
  id        String       @id @default(uuid())
  title     String       @db.VarChar(200)
  content   String // markdown/html content
  type      DocumentType @default(CUSTOM)
  authorId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ─── AI CHAT ────────────────────────────────────────────

model AIChat {
  id        String   @id @default(uuid())
  title     String?  @db.VarChar(200)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@map("ai_chats")
}

model AIMessage {
  id        String        @id @default(uuid())
  role      AIMessageRole
  content   String
  chatId    String
  createdAt DateTime      @default(now())

  chat AIChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

// ─── INTEGRATIONS ───────────────────────────────────────

model Integration {
  id           String              @id @default(uuid())
  provider     IntegrationProvider
  accessToken  String
  refreshToken String?
  externalId   String? // GitHub user id, etc.
  metadata     Json? // provider-specific data
  userId       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, userId])
  @@map("integrations")
}

// ─── ACTIVITY LOG ───────────────────────────────────────

model ActivityLog {
  id          String   @id @default(uuid())
  action      String   @db.VarChar(100) // "card.created", "card.moved", etc.
  entityType  String   @db.VarChar(50) // "card", "board", "project"
  entityId    String
  metadata    Json? // extra context
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String?
  isRead    Boolean          @default(false)
  linkUrl   String? // deep link to resource
  userId    String
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── PRODUCTIVITY METRICS ───────────────────────────────

model ProductivityMetric {
  id             String   @id @default(uuid())
  date           DateTime @db.Date
  cardsCreated   Int      @default(0)
  cardsCompleted Int      @default(0)
  commentsAdded  Int      @default(0)
  focusMinutes   Int      @default(0)
  userId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("productivity_metrics")
}
