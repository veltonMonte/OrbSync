# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/fluxionia?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/fluxionia?schema=public"
PORT=3001

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# CORS & Frontend URL
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Google Gemini AI
GEMINI_API_KEY="your-gemini-api-key"

# Google OAuth (Gmail Integration)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Search / Lead Scraping APIs
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
SERPER_API_KEY="your-serper-api-key"

# Email Sending (SMTP / Gmail)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"

# WhatsApp / Evolution API
EVOLUTION_API_URL="http://localhost:8080"
AUTHENTICATION_API_KEY="your-evolution-api-key"
